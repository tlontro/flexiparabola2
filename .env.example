# URL pública do website, sem barra no final.
# TODO: confirmar o domínio oficial da Flexiparabola.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Destino dos pedidos do formulário.
CONTACT_EMAIL=flexiparabola2@gmail.com

# Envio por SMTP. Sem SMTP_PASS o formulário não envia.
# Na conta Gmail flexiparabola2@gmail.com:
# 1. Ative a verificação em dois passos.
# 2. Crie uma palavra-passe de aplicação em https://myaccount.google.com/apppasswords
# 3. Cole-a em SMTP_PASS. Não use a palavra-passe normal da conta.
# 4. Reinicie o servidor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=flexiparabola2@gmail.com
SMTP_PASS=
